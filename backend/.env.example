# PostgreSQL Connection (requires pgvector extension)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# Redis Cloud URL (for job state, token limits, BYOK key storage)
# Format: redis://default:password@host:port
REDIS_CLOUD_URL=redis://default:your-redis-password@your-redis-host:6379

# Supabase JWT Secret (found in Supabase Dashboard > Settings > API > JWT Settings)
# Used to verify auth tokens server-side
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here


# Built-in LLM API Key 
# Required if you want the built-in chat model to work without BYOK
MISTRAL_API_KEY=your-mistral-api-key-here


# MLflow Tracking URI (optional, for local model training experiments)
# Defaults to sqlite if not set
MLFLOW_TRACKING_URI=sqlite:///mlflow.db


# for tracing, langsmith tracing 
LANGSMITH_TRACING=true
LANGSMITH_API_KEY='langsmith_api_key'
LANGSMITH_PROJECT="Agnenticfit"
